(version 1)
(allow default)
(deny file-write*)
(allow file-write* (subpath "/private/tmp/memory-host-four-tools.j6pymtdr/original-tools") (literal "/dev/null") (literal "/dev/tty"))
(deny file-read* (subpath "/Users") (subpath "/private/tmp") (subpath "/private/var/folders") (subpath "/Volumes") (subpath "/Users/csells/Code/Forks/sjarmak/mem"))
(allow file-read-metadata)
(allow file-read* (subpath "/opt/homebrew/Cellar/opencode/1.18.15/libexec/lib/node_modules/opencode-ai/bin") (subpath "/private/tmp/memory-host-four-tools.j6pymtdr/original-tools"))
(deny file-read-metadata (literal "/Users/csells/.config/bd/config.yaml") (literal "/Users/csells/.beads/config.yaml") (literal "/Users/csells/Library/Application Support/bd/config.yaml"))
