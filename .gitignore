# Python tool caches + coverage artifacts: regenerated locally / in CI, never
# committed. (Covered by a global excludesfile on dev machines too; pinned here
# so a fresh checkout / CI is junk-free without relying on global git config.)
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/

