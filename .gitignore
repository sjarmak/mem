# Gas City
.beads/*
!.beads/identity.toml
/.beads.gate.lock

# Local filesystem metadata and generated code-graph output.
.DS_Store
/graphify-out/

# Node
node_modules/
dist/

# Secrets — local environment / API keys (e.g. NGC_API_KEY for the local NIM)
.env
.env.*
!.env.example

# P1.5 work-audit store (generated artifact; built via `mem build-store`)
.mem/

# Internal working notes + Gas City project context (not public)
.gc/

# Paper draft — kept out of the public repo
paper/

# Day-0 perishable freeze (mem-wanz.1): commit the text index + manifest, but the
# multi-GB git bundles and in-flight partial captures are generated artifacts.
freeze/*/bundles/
freeze/*.partial-*

# Step-0 rig checkout+remote verification reports (mem-wanz.2): dated, machine-
# generated by scripts/verify-rig-checkouts.mjs — a reproducible local preflight,
# not a committed artifact.
verify/rig-checkouts.*.json

# NeMo-generated synthetic worlds (mem-t1k5): model output frozen by
# scripts/generate_worlds.py. Curated freezing + manifest is Phase 4 (mem-ge51);
# until then these are local generation artifacts, not committed.
memory-bench/fixtures/worlds/

# The tool-requiring corpus (mem-31vl), same stance. Since mem-qn1jr it is generated
# deterministically (`scripts/generate_worlds.py --offline --tool-requiring`), so it
# reproduces byte-for-byte from the seeds and `scripts/verify_worlds.py` re-checks that
# against each world's manifest. Regenerable exactly means there is nothing to commit.
memory-bench/fixtures/worlds-tool/

# Adoption-harness run directories (docs/adoption-harness/README.md). A run holds raw
# agent transcripts and per-session receipts for whoever paid for it; it is local
# evidence, not repository content, and this repo is public.
memory-bench/runs/

# Older experiments wrote local execution payloads under results/. Keep plans,
# grader source, manifests, summaries, and curated evidence packages visible;
# do not ignore results/ wholesale. Ignoring is not a backup: retain paid-run
# evidence locally or archive it separately before removing anything.
/memory-bench/results/beads_ordering/**/runs/
/memory-bench/results/beads_ordering/**/workspaces/
# These small pilot traces are already part of the shared evidence set.
!/memory-bench/results/beads_ordering/pilot-navigation/runs/
!/memory-bench/results/beads_ordering/pilot-search-only/runs/
/memory-bench/results/bd-*/**/sessions/
/memory-bench/results/bd-*/**/pairs/
/memory-bench/results/**/*.json.legs/
/memory-bench/results/**/*.log
/memory-bench/results/**/.coverage-*
/memory-bench/results/**/core-coverage.data

# Raw execution payloads from historical result campaigns. The reports and
# manifests summarize these runs; retain the paid payloads locally, but do not
# publish workspace snapshots, agent streams, terminal recordings, or bead
# exports from this public repository.
/memory-bench/results/**/*.tar
/memory-bench/results/**/leg-*/
/memory-bench/results/**/extracted-data/
/memory-bench/results/**/raw-results.jsonl
/memory-bench/results/**/pre-retry-raw-results.jsonl
/memory-bench/results/**/agent.stream.jsonl
/memory-bench/results/**/retrieval.jsonl
/memory-bench/results/**/stdout.txt
/memory-bench/results/**/stderr.txt
/memory-bench/results/**/BEAD_UPDATES.json
/memory-bench/results/**/*.cast
/memory-bench/results/**/*.gif
/memory-bench/results/**/*.mp4

# Machine-local run metadata and prompt/bead snapshots embed absolute home
# paths or raw task text. Keep derived reports and analyses visible while the
# source payload stays in the retained local campaign directory.
/memory-bench/results/**/leg/
