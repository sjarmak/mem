# Gas City
.beads/*
!.beads/identity.toml

# Node
node_modules/
dist/

# Secrets — local environment / API keys (e.g. NGC_API_KEY for the local NIM)
.env
.env.*
!.env.example

# P1.5 work-audit store (generated artifact; built via `mem build-store`)
.mem/

# Internal working notes + Gas City project context (not public)
.gc/

# Paper draft — kept out of the public repo
paper/

# Day-0 perishable freeze (mem-wanz.1): commit the text index + manifest, but the
# multi-GB git bundles and in-flight partial captures are generated artifacts.
freeze/*/bundles/
freeze/*.partial-*

# Step-0 rig checkout+remote verification reports (mem-wanz.2): dated, machine-
# generated by scripts/verify-rig-checkouts.mjs — a reproducible local preflight,
# not a committed artifact.
verify/rig-checkouts.*.json

# NeMo-generated synthetic worlds (mem-t1k5): model output frozen by
# scripts/generate_worlds.py. Curated freezing + manifest is Phase 4 (mem-ge51);
# until then these are local generation artifacts, not committed.
memory-bench/fixtures/worlds/

# The tool-requiring corpus (mem-31vl), same stance. Since mem-qn1jr it is generated
# deterministically (`scripts/generate_worlds.py --offline --tool-requiring`), so it
# reproduces byte-for-byte from the seeds and `scripts/verify_worlds.py` re-checks that
# against each world's manifest. Regenerable exactly means there is nothing to commit.
memory-bench/fixtures/worlds-tool/

# Adoption-harness run directories (docs/adoption-harness/README.md). A run holds raw
# agent transcripts and per-session receipts for whoever paid for it; it is local
# evidence, not repository content, and this repo is public.
memory-bench/runs/

# Python tool caches + coverage artifacts: regenerated locally / in CI, never
# committed. (Covered by a global excludesfile on dev machines too; pinned here
# so a fresh checkout / CI is junk-free without relying on global git config.)
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/

# Agent-tooling dot-folders: deliberately untracked (chore 8311409 removed them
# from the index but did not ignore them, so they kept resurfacing). Session-local.
.claude/
.codex/

# PL deep-audit / status reports (mem-pl): local operating artifacts, not committed.
.gc-reports/

# Preserve experiment verification scratch locally; publish its reports and logs.
memory-bench/results/memory-routes/verification-lifecycle-2026-09-06-01/active/cache/
memory-bench/results/memory-routes/verification-lifecycle-2026-09-06-01/active/pytest-temp/
# This failed smoke captured an absolute link into its disposable native store.
memory-bench/results/memory-routes/2026-09-06-host-common-smoke-opencode-01/session/workspace/AGENTS.md
# Parent inspection metadata; original native SQLite bytes remain preserved.
memory-bench/results/memory-routes/2026-09-06-e2e-01/cases/codex-installed/revised_search/native-after/memories_1.sqlite-shm
memory-bench/results/memory-routes/2026-09-06-e2e-01/cases/codex-installed/revised_search/native-after/memories_1.sqlite-wal
# Qualification retained these bundled plugin dependencies locally; publish the
# original hash inventory and transcripts, not another copy of the runtime cache.
memory-bench/results/memory-routes/2026-09-07-four-cli-smoke-01/zcode/*/native-after/cli/plugins/cache/
# Retained scratch checkout; its Git metadata and absolute link are local only.
memory-bench/results/memory-routes/2026-09-06-host-common-smoke-opencode-01/session/workspace/
# Policy qualification retains bundled runtime dependencies locally with hashes.
memory-bench/results/memory-routes/2026-09-07-policy-handoff-qualification-01/zcode-glm/capture/native-after/cli/plugins/cache/
memory-bench/results/memory-routes/2026-09-07-policy-handoff-qualification-01/zcode-glm/reuse/native-after/cli/plugins/cache/
# SQLite reader coordination is not evidence; keep the databases and captured WAL.
memory-bench/results/memory-routes/2026-09-07-policy-handoff-01/cases/*/stage-*/native-after/memories_1.sqlite-shm
memory-bench/results/memory-routes/2026-09-07-prime-delivery-01/cases/*/stage-*/native-after/memories_1.sqlite-shm
# Accidental machine-wide process inventory may include credentials; local only.
memory-bench/results/memory-routes/2026-09-07-prime-delivery-01/audits/infrastructure-h6guhoqn/process-inventory.txt
